# Copy to .env and fill in your key
GEMINI_API_KEY=your_key_here
PORT=3001

# Gemini extraction tuning (optional — sane defaults apply if unset)
# Pages per PDF chunk sent to Gemini in one request
GEMINI_PDF_CHUNK_PAGES=8
# Output token cap per request; gemini-2.5-flash's documented ceiling is 65536
GEMINI_MAX_OUTPUT_TOKENS=65536

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=eazeebooks

# Promote this email to platform owner on migration
ADMIN_EMAIL=toqeer.arif@walee.pk

# Password reset emails (SMTP via nodemailer)
SMTP_HOST=mail.eazeebooks.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@eazeebooks.com
SMTP_PASSWORD=CHdX8DTeJZDyvLXV
SMTP_FROM=no-reply@eazeebooks.com


# Base URL of the frontend, used to build the password-reset link sent by email
FRONTEND_URL=http://localhost:5173
