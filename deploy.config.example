# Copy this file to `deploy.config` (gitignored — contains server details)
# and fill in your HostNext / cPanel details. Then just run: npm run deploy
#
# How to find these values:
#   SSH_HOST / SSH_USER — cPanel → "SSH Access", or your General
#     Information card (Current User = SSH_USER).
#   SSH_PORT — HostNext doesn't disclose this directly, but cPanel's Git
#     Version Control feature reveals it: create/view a repo there and
#     look at the "Clone URL" (ssh://user@host:PORT/...) — the port in
#     that URL is your real SSH port.
#   REPO_PATH / APP_PATH — the live app's git checkout and Passenger app
#     root. Often the same folder (confirm via cPanel Terminal: does
#     `ls -la <folder>` show a `.git` directory directly inside it?).
#   NODE_VENV_ACTIVATE — cPanel → "Setup Node.js App" → your app → the
#     `source /home/.../nodevenv/.../bin/activate` line shown there.

SSH_HOST=your-server-hostname-or-ip
SSH_PORT=22
SSH_USER=your-cpanel-username
# Optional: path to a private key if you don't use ssh-agent/default key
SSH_KEY=

REPO_PATH=/home/username/your-app-folder
APP_PATH=/home/username/your-app-folder

NODE_VENV_ACTIVATE=/home/username/nodevenv/your-app-folder/20/bin/activate

BRANCH=main
