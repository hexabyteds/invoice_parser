# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/apexhome/eazeebooks.com"
PassengerBaseURI "/"
PassengerNodejs "/home/apexhome/nodevenv/eazeebooks.com/20/bin/node"
PassengerAppType node
PassengerStartupFile app-backend.js
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Canonicalize to https://eazeebooks.com in a single redirect, whether
    # the request came in as http, www, or both — previously only the www
    # case redirected, so http://eazeebooks.com/ (no www) served the full
    # site unencrypted with no redirect at all.
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.eazeebooks\.com$ [NC]
    RewriteRule ^(.*)$ https://eazeebooks.com/$1 [R=301,L]

    # Serve existing files/directories normally
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # React Router fallback
    RewriteRule ^ index.html [L]
</IfModule>

# Vite content-hashes every JS/CSS filename (e.g. index-C_WoY_yO.js), so a
# new deploy always produces new URLs — safe to cache these for a year
# instead of the 1h Passenger/Apache's static-file handler defaults to.
# Does not affect index.html, the prerendered snapshots, robots.txt,
# sitemap.xml, or llms.txt — none of those are .js/.css and none are
# content-hashed, so they must stay revalidated on every request.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
