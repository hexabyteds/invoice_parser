# Copy to .env.test (already gitignored) and adjust if your local MySQL differs.
# Used only by `npm test` — points at a dedicated test database, never the
# real dev/production one, and is dropped/recreated on every test run.

NODE_ENV=test
PORT=3099

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=invoice_saas_test

JWT_SECRET=test_only_jwt_secret_do_not_use_in_prod

# Seeded test-only admin account (created fresh by tests/setup/globalSetup.js).
# Not a real account and not the production admin credential.
QA_ADMIN_EMAIL=qa-admin@example.test
QA_ADMIN_PASSWORD=Qa-Test-Admin-123
# Password reset emails (SMTP via nodemailer)
SMTP_HOST=mail.eazeebooks.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@eazeebooks.com
SMTP_PASSWORD=CHdX8DTeJZDyvLXV
SMTP_FROM=no-reply@eazeebooks.com

# Stripe — tests mock the SDK, but the webhook tests still sign payloads
# using STRIPE_WEBHOOK_SECRET via stripe's own test-signing helper, so it
# must be set (any value works, it never talks to real Stripe).
STRIPE_SECRET_KEY=sk_test_dummy_key_for_tests
STRIPE_PUBLISHABLE_KEY=pk_test_dummy_key_for_tests
STRIPE_WEBHOOK_SECRET=whsec_test_dummy_secret_for_tests