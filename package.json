{
  "name": "eazeebooks",
  "version": "1.0.0",
  "description": "Invoice extraction web app powered by Google Gemini",
  "main": "app-backend.js",
  "scripts": {
    "start": "node app-backend.js",
    "migrate:admin": "node scripts/migrate-admin.js",
    "migrate": "node scripts/migrate.js",
    "deploy": "bash scripts/deploy.sh",
    "db:diff": "bash scripts/diff-schema.sh",
    "db:snapshot": "bash scripts/snapshot-schema.sh",
    "tunnel": "bash scripts/tunnel.sh",
    "share": "bash scripts/start-with-tunnel.sh",
    "dev": "nodemon app-backend.js",
    "dev:branch": "nodemon -r dotenv/config app-backend.js dotenv_config_path=.env.branch",
    "migrate:branch": "node -r dotenv/config scripts/migrate.js dotenv_config_path=.env.branch",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest --watch --runInBand"
  },
  "keywords": [
    "invoice",
    "gemini",
    "ocr",
    "extraction"
  ],
  "author": "Toqeer Arif",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.10.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.3.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.1",
    "google-libphonenumber": "^3.2.46",
    "i18n-iso-countries": "^7.14.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.22.6",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pdf2pic": "^3.2.0",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
