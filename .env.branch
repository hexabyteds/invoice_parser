# Local overrides for the feat/company-freelancer-tenancy branch.
# Loaded via `node -r dotenv/config ... dotenv_config_path=.env.branch`
# BEFORE app-backend.js's own dotenv.config() runs — and dotenv never
# overwrites a var that's already set, so only DB_NAME/PORT are overridden
# here; everything else (secrets, SMTP, Stripe test keys, etc.) still
# falls through to the real .env. This file is gitignored — never commit it.
DB_NAME=invoice_saas_tenancy_dev
PORT=3011
